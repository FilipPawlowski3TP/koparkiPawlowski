---
interface Props {
  items: { q: string; a: string }[];
}

const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <div class="faq__answer">
          <p>{item.a}</p>
        </div>
      </details>
    ))
  }
</div>
