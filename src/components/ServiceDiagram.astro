---
// Minischematy przekrojów dla poszczególnych usług (rysunki poglądowe).
interface Props {
  variant: 'fundament' | 'instalacje' | 'korytowanie' | 'niwelacja';
  caption: string;
}

const { variant, caption } = Astro.props;
---

<figure class="diagram diagram--small">
  <svg viewBox="0 0 420 200" role="img" aria-label={caption}>
    <defs>
      <pattern id={`h-${variant}`} width="12" height="12" patternTransform="rotate(45)" patternUnits="userSpaceOnUse">
        <line x1="0" y1="0" x2="0" y2="12" stroke="#b3a68e" stroke-width="1.3" />
      </pattern>
      <marker id={`a-${variant}`} viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
        <path d="M 0 0 L 10 5 L 0 10 z" fill="#ab4d26" />
      </marker>
    </defs>

    {variant === 'fundament' && (
      <g>
        <rect x="15" y="80" width="390" height="105" fill={`url(#h-${variant})`} />
        <rect x="140" y="80" width="150" height="85" fill="#f4efe6" stroke="#211c17" stroke-width="2.5" />
        <rect x="165" y="80" width="100" height="45" fill="#ebe3d4" stroke="#211c17" stroke-width="2.5" />
        <line x1="15" y1="80" x2="405" y2="80" stroke="#211c17" stroke-width="3" />
        <line x1="110" y1="80" x2="110" y2="165" stroke="#ab4d26" stroke-width="1.8" marker-start={`url(#a-${variant})`} marker-end={`url(#a-${variant})`} />
        <text x="30" y="68" font-family="ui-monospace, monospace" font-size="13" letter-spacing="2" fill="#5d554a">WYKOP POD FUNDAMENT</text>
        <text x="175" y="110" font-family="ui-monospace, monospace" font-size="12" letter-spacing="1.5" fill="#211c17">ŁAWA</text>
      </g>
    )}

    {variant === 'instalacje' && (
      <g>
        <rect x="15" y="70" width="390" height="115" fill={`url(#h-${variant})`} />
        <rect x="165" y="70" width="105" height="95" fill="#f4efe6" stroke="#211c17" stroke-width="2.5" />
        <circle cx="217" cy="118" r="24" fill="#ebe3d4" stroke="#211c17" stroke-width="2.5" />
        <line x1="15" y1="70" x2="405" y2="70" stroke="#211c17" stroke-width="3" />
        <line x1="217" y1="40" x2="217" y2="88" stroke="#ab4d26" stroke-width="1.8" marker-end={`url(#a-${variant})`} />
        <text x="232" y="46" font-family="ui-monospace, monospace" font-size="13" letter-spacing="2" fill="#5d554a">RURA / KABEL</text>
        <text x="30" y="200" font-family="ui-monospace, monospace" font-size="12" letter-spacing="1.5" fill="#5d554a">WYKOP LINIOWY</text>
      </g>
    )}

    {variant === 'korytowanie' && (
      <g>
        <rect x="15" y="95" width="390" height="90" fill={`url(#h-${variant})`} />
        <rect x="95" y="95" width="230" height="28" fill="#f4efe6" stroke="#211c17" stroke-width="2.5" />
        <rect x="95" y="123" width="230" height="10" fill="#ebe3d4" stroke="#211c17" stroke-width="1.8" />
        <rect x="95" y="72" width="230" height="23" fill="none" stroke="#211c17" stroke-width="2.5" stroke-dasharray="6 4" />
        <line x1="15" y1="95" x2="405" y2="95" stroke="#211c17" stroke-width="3" />
        <line x1="70" y1="72" x2="70" y2="133" stroke="#ab4d26" stroke-width="1.8" marker-start={`url(#a-${variant})`} marker-end={`url(#a-${variant})`} />
        <text x="30" y="60" font-family="ui-monospace, monospace" font-size="13" letter-spacing="2" fill="#5d554a">KORYTO POD KOSTKĘ</text>
        <text x="340" y="82" font-family="ui-monospace, monospace" font-size="11" letter-spacing="1.5" fill="#5d554a">POWIERZCHNIA</text>
      </g>
    )}

    {variant === 'niwelacja' && (
      <g>
        <rect x="15" y="110" width="390" height="75" fill={`url(#h-${variant})`} />
        <path d="M 15 110 C 90 88, 150 132, 230 108 S 350 122, 405 96" fill="none" stroke="#a89b86" stroke-width="2.5" stroke-dasharray="7 5" />
        <line x1="15" y1="110" x2="405" y2="110" stroke="#211c17" stroke-width="3" />
        <line x1="40" y1="110" x2="40" y2="92" stroke="#ab4d26" stroke-width="1.8" marker-end={`url(#a-${variant})`} />
        <line x1="210" y1="110" x2="210" y2="92" stroke="#ab4d26" stroke-width="1.8" marker-end={`url(#a-${variant})`} />
        <line x1="380" y1="110" x2="380" y2="92" stroke="#ab4d26" stroke-width="1.8" marker-end={`url(#a-${variant})`} />
        <text x="30" y="80" font-family="ui-monospace, monospace" font-size="13" letter-spacing="2" fill="#5d554a">NIWELACJA TERENU</text>
        <text x="240" y="140" font-family="ui-monospace, monospace" font-size="11" letter-spacing="1.5" fill="#5d554a">POZIOM REFERENCYJNY</text>
      </g>
    )}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .diagram--small {
    padding: var(--sp-2);
  }
</style>
