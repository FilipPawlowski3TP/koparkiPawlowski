---
import '@fontsource-variable/archivo';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, structuredData } from '../site.config.mjs';

interface Props {
  title: string;
  description: string;
  jsonLd?: object | object[];
  ogImage?: string;
}

const { title, description, jsonLd, ogImage = '/images/og-image.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const schemas = [structuredData, ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])];
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#211c17" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pl_PL" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(ogImage, site.url).href} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    {
      schemas.map((schema) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#tresc">Przejdź do treści</a>
    <Header />
    <main id="tresc">
      <slot />
    </main>
    <Footer />

    <!-- Mobilny pasek kontaktu -->
    <div class="mobile-call" id="mobile-call">
      <a class="mobile-call__btn" href={`tel:${site.phoneHref}`}>
        <span class="mobile-call__label">Zadzwoń</span>
        <span class="mobile-call__num">{site.phoneDisplay}</span>
      </a>
    </div>

    <style>
      .mobile-call {
        position: fixed;
        inset: auto 0 0 0;
        z-index: 50;
        padding: 0.6rem 0.9rem calc(0.6rem + env(safe-area-inset-bottom));
        background: var(--ink);
        border-top: 2px solid var(--clay);
      }

      .mobile-call__btn {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.75rem;
        background: var(--clay);
        color: var(--paper);
        text-decoration: none;
        padding: 0.8rem 1rem;
        font-family: var(--font-mono);
        letter-spacing: 0.08em;
        text-transform: uppercase;
      }

      .mobile-call__btn:active {
        background: var(--clay-dark);
      }

      .mobile-call__label {
        font-size: 0.85rem;
      }

      .mobile-call__num {
        font-size: 1.15rem;
        font-weight: 700;
        letter-spacing: 0.04em;
      }

      @media (min-width: 48rem) {
        .mobile-call {
          display: none;
        }
      }
    </style>
  </body>
</html>
