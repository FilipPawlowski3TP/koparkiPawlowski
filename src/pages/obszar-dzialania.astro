---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../site.config.mjs';
---

<Base
  title="Obszar działania — Wrocław i okolice | Koparki Pawłowski"
  description="Usługi minikoparką realizujemy we Wrocławiu i okolicach. Sprawdź, czy dojedziemy pod Twój adres — zadzwoń: 792 611 777."
>
  <section class="section">
    <div class="container">
      <p class="eyebrow">Gdzie pracujemy</p>
      <h1>Obszar działania — Wrocław i okolice</h1>
      <p class="lead">
        Realizujemy roboty ziemne minikoparką na terenie Wrocławia i miejscowości w okolicy.
        Nie prowadzimy listy „obsługiwanych dzielnic" — po prostu zadzwoń i podaj adres, a
        od razu potwierdzimy, czy dojedziemy.
      </p>
    </div>
  </section>

  <section class="section section--deep">
    <div class="container grid-2">
      <div>
        <SectionHead eyebrow="Zasięg" title="Wrocław i okolice" />
        <p>
          Naszym podstawowym obszarem jest <strong>Wrocław</strong> — realizujemy zlecenia na
          terenie miasta, od centrum po obrzeża. Dojeżdżamy również do <strong>miejscowości w
          okolicach Wrocławia</strong>.
        </p>
        <p>
          Odległość ma znaczenie przy planowaniu wyjazdu, dlatego każdorazowo potwierdzamy
          dojazd telefonicznie. Przy podawaniu adresu uwzględnij miejscowość i, jeśli to
          możliwe, dojazd do posesji (np. wąski wjazd, brak utwardzonej drogi).
        </p>
        <a class="btn btn--primary" href={`tel:${site.phoneHref}`}>
          <span class="btn__num" aria-hidden="true">☎</span> Zapytaj o dojazd: {site.phoneDisplay}
        </a>
      </div>
      <div>
        <SectionHead eyebrow="Kontakt" title="Godziny otwarcia" />
        <table class="hours-table">
          <thead>
            <tr><th>Dzień</th><th>Godziny</th></tr>
          </thead>
          <tbody>
            {
              site.hours.map((h) => (
                <tr>
                  <td>{h.days}</td>
                  <td>{h.hours}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
        <p class="mt-3">
          E-mail: <a href={`mailto:${site.email}`}>{site.email}</a>
        </p>
      </div>
    </div>
  </section>

  <CtaBand
    title="Nie wiesz, czy dojedziemy?"
    text="Zadzwoń i podaj miejscowość. Potwierdzimy dojazd w kilka sekund."
  />
</Base>
